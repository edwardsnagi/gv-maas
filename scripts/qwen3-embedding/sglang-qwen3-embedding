#!/usr/bin/env bash
set -euo pipefail

# Qwen3-Embedding (4B / 8B) on SGLang (--is-embedding, OpenAI /v1/embeddings).
# Full config: scripts/qwen3-embedding/README.md
#
# Usage:
#   ./sglang-qwen3-embedding                              # interactive wizard
#   ./sglang-qwen3-embedding -size=8b -slot=1 -port=20001 -y

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../qwen3.8-27b-fp8/lib/interactive.sh
source "${SCRIPT_DIR}/../qwen3.8-27b-fp8/lib/interactive.sh"
# shellcheck source=lib/embedding-wizard.sh
source "${SCRIPT_DIR}/lib/embedding-wizard.sh"
# shellcheck source=../qwen3.8-27b-fp8/lib/smoke-tests.sh
source "${SCRIPT_DIR}/../qwen3.8-27b-fp8/lib/smoke-tests.sh"

DATA_ROOT="${DATA_ROOT:-/data/edwardluke}"
VENV_DIR="${VENV_DIR:-${DATA_ROOT}/venvs/sglang}"
SGLANG_CACHE_DIR="${SGLANG_CACHE_DIR:-${DATA_ROOT}/cache/sglang}"
PYTHON="${PYTHON:-${VENV_DIR}/bin/python}"

EMBED_MODEL_SIZE="${EMBED_MODEL_SIZE:-8b}"
MODEL_PATH=""
MODEL_NAME=""
HOST="${HOST:-0.0.0.0}"
PORT="${PORT:-20001}"
MEM_FRACTION_STATIC=""
MEM_FRACTION_EXPLICIT=0
LOG_FILE="${LOG_FILE:-${SGLANG_CACHE_DIR}/sglang-embedding-server.log}"
PID_FILE="${PID_FILE:-${SGLANG_CACHE_DIR}/sglang-embedding-server.pid}"
STARTUP_TIMEOUT="${STARTUP_TIMEOUT:-300}"

SLOT=""
SKIP_INTERACTIVE="${SKIP_INTERACTIVE:-0}"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Options:
  -size=4b|8b     Model size (default: 8b)
  -slot=N         GPU slot (default: 1)
  -port=N         HTTP port (default: 20001, Embedding 2xxxx)
  -mem=F          mem-fraction-static (default: 4b=0.21, 8b=0.45)
  -y, --yes       Skip interactive wizard
  -h, --help      Show this help

Interactive mode (default on TTY): size → slot → port.
Shared SGLang venv: ./scripts/qwen3.8-27b-fp8/sglang-install

4B default mem-fraction-static is low (0.21) so a reranker can share the same GPU.
Env overrides: MODEL_PATH, PORT, EMBED_MODEL_SIZE, MEM_FRACTION_STATIC,
  VENV_DIR, SGLANG_CACHE_DIR, LOG_FILE, STARTUP_TIMEOUT, SKIP_INTERACTIVE=1,
  SKIP_SMOKE_TEST=1
EOF
}

default_mem_fraction_for_embedding() {
  case "${EMBED_MODEL_SIZE}" in
    4b) printf '0.21' ;;
    8b) printf '0.45' ;;
    *) printf '0.45' ;;
  esac
}

resolve_mem_fraction() {
  if [[ "${MEM_FRACTION_EXPLICIT}" == "1" && -n "${MEM_FRACTION_STATIC}" ]]; then
    return 0
  fi
  if [[ -n "${MEM_FRACTION_STATIC}" ]]; then
    return 0
  fi
  MEM_FRACTION_STATIC="$(default_mem_fraction_for_embedding)"
}

escape_regex() {
  printf '%s' "$1" | sed 's/[][\\.*^$()+?{|]/\\&/g'
}

find_previous_pids() {
  local model_re="${1}" port="${2}" pids=""
  pids="$(pgrep -f "sglang\\.launch_server.*${model_re}" 2>/dev/null | tr '\n' ' ' || true)"
  if [[ -z "${pids// /}" ]]; then
    pids="$(pgrep -f "sglang\\.launch_server.*--port ${port}" 2>/dev/null | tr '\n' ' ' || true)"
  fi
  printf '%s' "${pids}" | xargs -r echo
}

kill_pid_tree() {
  local pid="${1}" child
  for child in $(pgrep -P "${pid}" 2>/dev/null || true); do
    kill_pid_tree "${child}"
  done
  kill -TERM "${pid}" 2>/dev/null || true
}

wait_for_port_free() {
  local port="${1}" i=0
  while [[ "${i}" -lt 30 ]]; do
    if ! ss -ltn 2>/dev/null | grep -q ":${port} "; then
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done
  return 1
}

stop_previous_server() {
  local model_re pids pid still_running
  model_re="$(escape_regex "${MODEL_PATH}")"
  pids="$(find_previous_pids "${model_re}" "${PORT}")"

  if [[ -z "${pids// /}" ]]; then
    return 0
  fi

  echo "Stopping previous embedding server on port ${PORT} (PIDs: ${pids})..."
  for pid in ${pids}; do
    kill_pid_tree "${pid}"
  done

  for _ in $(seq 1 30); do
    still_running="$(find_previous_pids "${model_re}" "${PORT}")"
    [[ -z "${still_running// /}" ]] && break
    sleep 1
  done

  still_running="$(find_previous_pids "${model_re}" "${PORT}")"
  if [[ -n "${still_running// /}" ]]; then
    echo "Force killing remaining processes: ${still_running}"
    for pid in ${still_running}; do
      kill -KILL "${pid}" 2>/dev/null || true
      pkill -KILL -P "${pid}" 2>/dev/null || true
    done
    sleep 1
  fi

  wait_for_port_free "${PORT}" || \
    echo "WARNING: port ${PORT} still in use after stop attempt" >&2
}

health_host() {
  local host="${1}"
  [[ "${host}" == "0.0.0.0" || "${host}" == "::" ]] && host="127.0.0.1"
  printf '%s' "${host}"
}

health_url() {
  printf 'http://%s:%s/health' "$(health_host "${HOST}")" "${PORT}"
}

server_alive() {
  kill -0 "${1}" 2>/dev/null
}

wait_for_server_ready() {
  local pid="${1}" url="${2}" timeout="${3}" elapsed=0

  echo "Waiting for server to become ready (timeout ${timeout}s)..."
  while [[ "${elapsed}" -lt "${timeout}" ]]; do
    if ! server_alive "${pid}"; then
      echo "ERROR: server process ${pid} exited during startup." >&2
      tail -30 "${LOG_FILE}" >&2
      exit 1
    fi

    if curl -sf "${url}" >/dev/null 2>&1; then
      return 0
    fi

    sleep 2
    elapsed=$((elapsed + 2))
    if (( elapsed % 30 == 0 )); then
      echo "  still starting... (${elapsed}s, tail -f ${LOG_FILE})"
    fi
  done

  echo "ERROR: server did not become ready within ${timeout}s." >&2
  tail -30 "${LOG_FILE}" >&2
  exit 1
}

validate_slots() {
  local slots="${1}"
  [[ "${slots}" =~ ^[0-9]+$ ]] || {
    echo "ERROR: invalid slot: ${slots} (single GPU id, e.g. 1)" >&2
    exit 1
  }
  printf '%s' "${slots}"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      -y|--yes)
        SKIP_INTERACTIVE=1
        shift
        ;;
      -size=*)
        EMBED_MODEL_SIZE="${1#-size=}"
        shift
        ;;
      -size)
        [[ $# -ge 2 ]] || { echo "ERROR: -size requires 4b or 8b" >&2; exit 1; }
        EMBED_MODEL_SIZE="$2"
        shift 2
        ;;
      -slot=*)
        SLOT="${1#-slot=}"
        shift
        ;;
      -slot)
        [[ $# -ge 2 ]] || { echo "ERROR: -slot requires a value" >&2; exit 1; }
        SLOT="$2"
        shift 2
        ;;
      -port=*)
        PORT="${1#-port=}"
        shift
        ;;
      -port)
        [[ $# -ge 2 ]] || { echo "ERROR: -port requires a value" >&2; exit 1; }
        PORT="$2"
        shift 2
        ;;
      -mem=*)
        MEM_FRACTION_STATIC="${1#-mem=}"
        MEM_FRACTION_EXPLICIT=1
        shift
        ;;
      -mem)
        [[ $# -ge 2 ]] || { echo "ERROR: -mem requires a value" >&2; exit 1; }
        MEM_FRACTION_STATIC="$2"
        MEM_FRACTION_EXPLICIT=1
        shift 2
        ;;
      *)
        echo "ERROR: unknown argument: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

config_complete() {
  [[ -n "${SLOT}" && -n "${PORT}" && -n "${EMBED_MODEL_SIZE}" ]]
}

resolve_config() {
  parse_args "$@"

  if [[ "${SKIP_INTERACTIVE}" == "1" ]]; then
    EMBED_MODEL_SIZE="${EMBED_MODEL_SIZE:-8b}"
    SLOT="${SLOT:-1}"
    PORT="${PORT:-20001}"
    resolve_embedding_paths || exit 1
  elif [[ -t 0 ]] && ! config_complete; then
    run_embedding_wizard
    [[ "${WIZ_LAUNCH_ABORT:-0}" == "1" ]] && exit 0
  else
    EMBED_MODEL_SIZE="${EMBED_MODEL_SIZE:-8b}"
    SLOT="${SLOT:-${CUDA_VISIBLE_DEVICES:-1}}"
    PORT="${PORT:-20001}"
    resolve_embedding_paths || exit 1
  fi

  SLOT="$(validate_slots "${SLOT}")"
  validate_port "${PORT}" || exit 1
  resolve_embedding_paths || exit 1
  resolve_mem_fraction
  CUDA_VISIBLE_DEVICES="${SLOT}"
}

resolve_config "$@"

if [[ ! -x "${PYTHON}" ]]; then
  echo "ERROR: ${PYTHON} not found. Run ./scripts/qwen3.8-27b-fp8/sglang-install first." >&2
  exit 1
fi

echo "Using model: ${MODEL_NAME}  slot=${CUDA_VISIBLE_DEVICES}  port=${PORT}  mem-fraction-static=${MEM_FRACTION_STATIC}"

if [[ "${SKIP_INTERACTIVE}" == "1" || "${WIZ_REPLACE:-0}" == "1" ]]; then
  stop_previous_server
fi

VENV_BIN="$(dirname "${PYTHON}")"
export PATH="${VENV_BIN}:${PATH}"
export SGLANG_CACHE_DIR
mkdir -p "${SGLANG_CACHE_DIR}"
: > "${LOG_FILE}"

LAUNCH_ARGS=(
  --model-path "${MODEL_PATH}"
  --is-embedding
  --host "${HOST}"
  --port "${PORT}"
  --trust-remote-code
  --mem-fraction-static "${MEM_FRACTION_STATIC}"
  --attention-backend triton
)

nohup env CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES}" \
  SGLANG_CACHE_DIR="${SGLANG_CACHE_DIR}" \
  PATH="${PATH}" \
  "${PYTHON}" -m sglang.launch_server \
  "${LAUNCH_ARGS[@]}" \
  >> "${LOG_FILE}" 2>&1 &

SERVER_PID=$!
disown "${SERVER_PID}" 2>/dev/null || true
printf '%s\n' "${SERVER_PID}" > "${PID_FILE}"

HEALTH_HOST="$(health_host "${HOST}")"
wait_for_server_ready "${SERVER_PID}" "$(health_url)" "${STARTUP_TIMEOUT}"

if [[ "${SKIP_SMOKE_TEST:-0}" != "1" ]]; then
  EMBED_EXPECTED_DIM="$(smoke_expected_embedding_dim "${EMBED_MODEL_SIZE}")"
  smoke_run "Embedding /v1/embeddings (dim=${EMBED_EXPECTED_DIM})" "${SERVER_PID}" "${LOG_FILE}" \
    smoke_test_embedding "${HEALTH_HOST}" "${PORT}" "${MODEL_PATH}" "${EMBED_EXPECTED_DIM}" "${PYTHON}" \
    || exit 1
fi

echo "Embedding server is ready (running in background)."
echo "  PID:    ${SERVER_PID}"
echo "  Log:    ${LOG_FILE}"
echo "  URL:    http://${HEALTH_HOST}:${PORT}"
echo "  Check:  curl http://${HEALTH_HOST}:${PORT}/health"
echo "  Test:   curl http://${HEALTH_HOST}:${PORT}/v1/embeddings -H 'Content-Type: application/json' \\"
echo "            -d '{\"model\":\"${MODEL_PATH}\",\"input\":\"你好\"}'"
echo "  Follow: tail -f ${LOG_FILE}"
