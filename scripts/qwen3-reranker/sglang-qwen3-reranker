#!/usr/bin/env bash
set -euo pipefail

# Qwen3-Reranker (4B / 8B) on SGLang (/v1/rerank, decoder-only yes/no scoring).
# Full config: scripts/qwen3-reranker/README.md
#
# Usage:
#   ./sglang-qwen3-reranker -size=4b -slot=3 -port=30002 -y
#   ./sglang-qwen3-reranker -size=4b -slot=3 -port=30002 -mem=0.24 -y

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../qwen3.8-27b-fp8/lib/interactive.sh
source "${SCRIPT_DIR}/../qwen3.8-27b-fp8/lib/interactive.sh"
# shellcheck source=../qwen3.8-27b-fp8/lib/smoke-tests.sh
source "${SCRIPT_DIR}/../qwen3.8-27b-fp8/lib/smoke-tests.sh"

DATA_ROOT="${DATA_ROOT:-/data/edwardluke}"
VENV_DIR="${VENV_DIR:-${DATA_ROOT}/venvs/sglang}"
SGLANG_CACHE_DIR="${SGLANG_CACHE_DIR:-${DATA_ROOT}/cache/sglang}"
PYTHON="${PYTHON:-${VENV_DIR}/bin/python}"

RERANK_MODEL_SIZE="${RERANK_MODEL_SIZE:-4b}"
MODEL_PATH=""
MODEL_NAME=""
CHAT_TEMPLATE=""
HOST="${HOST:-0.0.0.0}"
PORT="${PORT:-30001}"
MEM_FRACTION_STATIC=""
MEM_FRACTION_EXPLICIT=0
LOG_FILE="${LOG_FILE:-${SGLANG_CACHE_DIR}/sglang-reranker-server.log}"
PID_FILE="${PID_FILE:-${SGLANG_CACHE_DIR}/sglang-reranker-server.pid}"
STARTUP_TIMEOUT="${STARTUP_TIMEOUT:-300}"

SLOT=""
SKIP_INTERACTIVE="${SKIP_INTERACTIVE:-0}"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Options:
  -size=4b|8b     Model size (default: 4b)
  -slot=N         GPU slot (default: 2 — often same GPU as 4B embedding)
  -port=N         HTTP port (default: 30001, Reranker 3xxxx)
  -mem=F          mem-fraction-static (default: 4b=0.24, 8b=0.48)
  -y, --yes       Skip prompts (auto-replace existing instance)
  -h, --help      Show this help

Do NOT use --is-embedding for Qwen3-Reranker (decoder-only yes/no logprob scoring).
4B default mem-fraction-static is 0.24 for co-location with 4B embedding on one GPU.
First startup may take 1–3 min (CUDA graph capture); tail the log if it looks idle.

Shared SGLang venv: ./scripts/qwen3.8-27b-fp8/sglang-install

Env overrides: MODEL_PATH, PORT, RERANK_MODEL_SIZE, MEM_FRACTION_STATIC,
  VENV_DIR, SGLANG_CACHE_DIR, LOG_FILE, STARTUP_TIMEOUT, SKIP_SMOKE_TEST=1
EOF
}

resolve_reranker_paths() {
  RERANK_MODEL_SIZE="$(printf '%s' "${RERANK_MODEL_SIZE}" | tr '[:upper:]' '[:lower:]')"
  case "${RERANK_MODEL_SIZE}" in
    4b)
      MODEL_PATH="${MODEL_PATH:-/data/models/Qwen3-Reranker-4B}"
      MODEL_NAME="Qwen3-Reranker-4B"
      ;;
    8|8b)
      RERANK_MODEL_SIZE="8b"
      # Weights live under Qwen3-Reranker-8 on disk; optional symlink Qwen3-Reranker-8B works too.
      if [[ -d /data/models/Qwen3-Reranker-8B ]]; then
        MODEL_PATH="${MODEL_PATH:-/data/models/Qwen3-Reranker-8B}"
      else
        MODEL_PATH="${MODEL_PATH:-/data/models/Qwen3-Reranker-8}"
      fi
      MODEL_NAME="Qwen3-Reranker-8B"
      ;;
    *)
      printf '  %s%s invalid size: %s (use 4b or 8b)%s\n' "${CR}" "${G_FAIL}" "${RERANK_MODEL_SIZE}" "${C0}" >&2
      return 1
      ;;
  esac
  # HF model chat_template.jinja uses role=query/document; SGLang /v1/rerank passes
  # messages[0]/messages[1] as user content. Use our bundled SGLang-compatible template.
  CHAT_TEMPLATE="${CHAT_TEMPLATE:-${SCRIPT_DIR}/lib/qwen3_reranker.jinja}"
  [[ -f "${CHAT_TEMPLATE}" ]] || {
    echo "ERROR: chat template not found: ${CHAT_TEMPLATE}" >&2
    return 1
  }
}

default_mem_fraction_for_reranker() {
  case "${RERANK_MODEL_SIZE}" in
    4b) printf '0.24' ;;
    8b) printf '0.48' ;;
    *) printf '0.45' ;;
  esac
}

resolve_mem_fraction() {
  if [[ "${MEM_FRACTION_EXPLICIT}" == "1" && -n "${MEM_FRACTION_STATIC}" ]]; then
    return 0
  fi
  if [[ -n "${MEM_FRACTION_STATIC}" ]]; then
    return 0
  fi
  MEM_FRACTION_STATIC="$(default_mem_fraction_for_reranker)"
}

escape_regex() {
  printf '%s' "$1" | sed 's/[][\\.*^$()+?{|]/\\&/g'
}

find_previous_pids() {
  local model_re="${1}" port="${2}" pids=""
  pids="$(pgrep -f "sglang\\.launch_server.*${model_re}" 2>/dev/null | tr '\n' ' ' || true)"
  if [[ -z "${pids// /}" ]]; then
    pids="$(pgrep -f "sglang\\.launch_server.*--port ${port}" 2>/dev/null | tr '\n' ' ' || true)"
  fi
  printf '%s' "${pids}" | xargs -r echo
}

kill_pid_tree() {
  local pid="${1}" child
  for child in $(pgrep -P "${pid}" 2>/dev/null || true); do
    kill_pid_tree "${child}"
  done
  kill -TERM "${pid}" 2>/dev/null || true
}

wait_for_port_free() {
  local port="${1}" i=0
  while [[ "${i}" -lt 30 ]]; do
    if ! ss -ltn 2>/dev/null | grep -q ":${port} "; then
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done
  return 1
}

stop_previous_server() {
  local model_re pids pid still_running
  model_re="$(escape_regex "${MODEL_PATH}")"
  pids="$(find_previous_pids "${model_re}" "${PORT}")"

  if [[ -z "${pids// /}" ]]; then
    return 0
  fi

  echo "Stopping previous reranker server on port ${PORT} (PIDs: ${pids})..."
  for pid in ${pids}; do
    kill_pid_tree "${pid}"
  done

  for _ in $(seq 1 30); do
    still_running="$(find_previous_pids "${model_re}" "${PORT}")"
    [[ -z "${still_running// /}" ]] && break
    sleep 1
  done

  still_running="$(find_previous_pids "${model_re}" "${PORT}")"
  if [[ -n "${still_running// /}" ]]; then
    echo "Force killing remaining processes: ${still_running}"
    for pid in ${still_running}; do
      kill -KILL "${pid}" 2>/dev/null || true
      pkill -KILL -P "${pid}" 2>/dev/null || true
    done
    sleep 1
  fi

  wait_for_port_free "${PORT}" || \
    echo "WARNING: port ${PORT} still in use after stop attempt" >&2
}

health_host() {
  local host="${1}"
  [[ "${host}" == "0.0.0.0" || "${host}" == "::" ]] && host="127.0.0.1"
  printf '%s' "${host}"
}

health_url() {
  printf 'http://%s:%s/health' "$(health_host "${HOST}")" "${PORT}"
}

server_alive() {
  kill -0 "${1}" 2>/dev/null
}

wait_for_server_ready() {
  local pid="${1}" url="${2}" timeout="${3}" elapsed=0

  echo "Waiting for server to become ready (timeout ${timeout}s)..."
  while [[ "${elapsed}" -lt "${timeout}" ]]; do
    if ! server_alive "${pid}"; then
      echo "ERROR: server process ${pid} exited during startup." >&2
      tail -30 "${LOG_FILE}" >&2
      exit 1
    fi

    if curl -sf "${url}" >/dev/null 2>&1; then
      return 0
    fi

    sleep 2
    elapsed=$((elapsed + 2))
    if (( elapsed % 30 == 0 )); then
      echo "  still starting... (${elapsed}s, tail -f ${LOG_FILE})"
    fi
  done

  echo "ERROR: server did not become ready within ${timeout}s." >&2
  tail -30 "${LOG_FILE}" >&2
  exit 1
}

validate_slots() {
  local slots="${1}"
  [[ "${slots}" =~ ^[0-9]+$ ]] || {
    echo "ERROR: invalid slot: ${slots} (single GPU id, e.g. 2)" >&2
    exit 1
  }
  printf '%s' "${slots}"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      -y|--yes)
        SKIP_INTERACTIVE=1
        shift
        ;;
      -size=*)
        RERANK_MODEL_SIZE="${1#-size=}"
        shift
        ;;
      -size)
        [[ $# -ge 2 ]] || { echo "ERROR: -size requires 4b or 8b" >&2; exit 1; }
        RERANK_MODEL_SIZE="$2"
        shift 2
        ;;
      -slot=*)
        SLOT="${1#-slot=}"
        shift
        ;;
      -slot)
        [[ $# -ge 2 ]] || { echo "ERROR: -slot requires a value" >&2; exit 1; }
        SLOT="$2"
        shift 2
        ;;
      -port=*)
        PORT="${1#-port=}"
        shift
        ;;
      -port)
        [[ $# -ge 2 ]] || { echo "ERROR: -port requires a value" >&2; exit 1; }
        PORT="$2"
        shift 2
        ;;
      -mem=*)
        MEM_FRACTION_STATIC="${1#-mem=}"
        MEM_FRACTION_EXPLICIT=1
        shift
        ;;
      -mem)
        [[ $# -ge 2 ]] || { echo "ERROR: -mem requires a value" >&2; exit 1; }
        MEM_FRACTION_STATIC="$2"
        MEM_FRACTION_EXPLICIT=1
        shift 2
        ;;
      *)
        echo "ERROR: unknown argument: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

parse_args "$@"

RERANK_MODEL_SIZE="${RERANK_MODEL_SIZE:-4b}"
SLOT="${SLOT:-2}"
PORT="${PORT:-30001}"

resolve_reranker_paths || exit 1
SLOT="$(validate_slots "${SLOT}")"
validate_port "${PORT}" || exit 1
resolve_mem_fraction

if [[ ! -x "${PYTHON}" ]]; then
  echo "ERROR: ${PYTHON} not found. Run ./scripts/qwen3.8-27b-fp8/sglang-install first." >&2
  exit 1
fi

echo "Using model: ${MODEL_NAME}  slot=${SLOT}  port=${PORT}  mem-fraction-static=${MEM_FRACTION_STATIC}"

if [[ "${SKIP_INTERACTIVE}" == "1" ]]; then
  stop_previous_server
fi

VENV_BIN="$(dirname "${PYTHON}")"
export PATH="${VENV_BIN}:${PATH}"
export SGLANG_CACHE_DIR
mkdir -p "${SGLANG_CACHE_DIR}"
: > "${LOG_FILE}"

LAUNCH_ARGS=(
  --model-path "${MODEL_PATH}"
  --host "${HOST}"
  --port "${PORT}"
  --trust-remote-code
  --chat-template "${CHAT_TEMPLATE}"
  --mem-fraction-static "${MEM_FRACTION_STATIC}"
  --disable-radix-cache
  --attention-backend triton
)

nohup env CUDA_VISIBLE_DEVICES="${SLOT}" \
  SGLANG_CACHE_DIR="${SGLANG_CACHE_DIR}" \
  PATH="${PATH}" \
  "${PYTHON}" -m sglang.launch_server \
  "${LAUNCH_ARGS[@]}" \
  >> "${LOG_FILE}" 2>&1 &

SERVER_PID=$!
disown "${SERVER_PID}" 2>/dev/null || true
printf '%s\n' "${SERVER_PID}" > "${PID_FILE}"

HEALTH_HOST="$(health_host "${HOST}")"
wait_for_server_ready "${SERVER_PID}" "$(health_url)" "${STARTUP_TIMEOUT}"

if [[ "${SKIP_SMOKE_TEST:-0}" != "1" ]]; then
  smoke_run "Reranker /v1/rerank (score discrimination)" "${SERVER_PID}" "${LOG_FILE}" \
    smoke_test_reranker "${HEALTH_HOST}" "${PORT}" "${MODEL_PATH}" "${PYTHON}" \
    || exit 1
fi

echo "Reranker server is ready (running in background)."
echo "  PID:    ${SERVER_PID}"
echo "  Log:    ${LOG_FILE}"
echo "  URL:    http://${HEALTH_HOST}:${PORT}"
echo "  Check:  curl http://${HEALTH_HOST}:${PORT}/health"
echo "  Test:   curl http://${HEALTH_HOST}:${PORT}/v1/rerank -H 'Content-Type: application/json' \\"
echo "            -d '{\"model\":\"${MODEL_PATH}\",\"query\":\"What is Python?\",\"documents\":[\"Python is a programming language.\",\"The sky is blue.\"]}'"
echo "  Follow: tail -f ${LOG_FILE}"
