#!/usr/bin/env bash
set -euo pipefail

# Qwen3.8-27B-FP8 on SGLang (OpenAI-compatible /v1).
# Full config: scripts/qwen3.8-27b-fp8/README.md
#
# Usage:
#   ./sglang-qwen3.8-27b-fp8                              # interactive wizard
#   ./sglang-qwen3.8-27b-fp8 -slot=0 -port=8000 -tp=1 -dp=1 -y

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/interactive.sh
source "${SCRIPT_DIR}/lib/interactive.sh"

DATA_ROOT="${DATA_ROOT:-/data/edwardluke}"
VENV_DIR="${VENV_DIR:-${DATA_ROOT}/venvs/sglang}"
SGLANG_CACHE_DIR="${SGLANG_CACHE_DIR:-${DATA_ROOT}/cache/sglang}"
PYTHON="${PYTHON:-${VENV_DIR}/bin/python}"

MODEL_PATH="${MODEL_PATH:-/data/models/Qwen3.8-27B-FP8}"
MODEL_NAME="Qwen3.8-27B-FP8"
HOST="${HOST:-0.0.0.0}"
PORT="${PORT:-8000}"
TP_SIZE="${TP_SIZE:-1}"
DP_SIZE="${DP_SIZE:-1}"
MEM_FRACTION_STATIC="${MEM_FRACTION_STATIC:-0.85}"
LOG_FILE="${LOG_FILE:-${SGLANG_CACHE_DIR}/sglang-server.log}"
PID_FILE="${PID_FILE:-${SGLANG_CACHE_DIR}/sglang-server.pid}"
STARTUP_TIMEOUT="${STARTUP_TIMEOUT:-600}"

SLOT=""
SKIP_INTERACTIVE="${SKIP_INTERACTIVE:-0}"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Options:
  -slot=N[,N...]   GPU slot(s), comma-separated
  -port=N          HTTP port (default: 8000)
  -tp=N            Tensor parallel size (default: 1)
  -dp=N            Data parallel size (default: 1)
  -y, --yes        Skip interactive wizard, use CLI/env defaults
  -h, --help       Show this help

Interactive mode (default on TTY): 3-step wizard — slots → tp/dp → port.
See scripts/qwen3.8-27b-fp8/README.md for recommended configs.

The server runs in the background; the script waits until /health is OK before returning.

Env overrides: MODEL_PATH, PORT, TP_SIZE, DP_SIZE, HOST, MEM_FRACTION_STATIC,
  VENV_DIR, SGLANG_CACHE_DIR, LOG_FILE, STARTUP_TIMEOUT, SKIP_INTERACTIVE=1
EOF
}

escape_regex() {
  printf '%s' "$1" | sed 's/[][\\.*^$()+?{|]/\\&/g'
}

find_previous_pids() {
  local model_re="${1}" port="${2}" pids=""
  pids="$(pgrep -f "sglang\\.launch_server.*${model_re}" 2>/dev/null | tr '\n' ' ' || true)"
  if [[ -z "${pids// /}" ]]; then
    pids="$(pgrep -f "sglang\\.launch_server.*--port ${port}" 2>/dev/null | tr '\n' ' ' || true)"
  fi
  printf '%s' "${pids}" | xargs -r echo
}

kill_pid_tree() {
  local pid="${1}" child
  for child in $(pgrep -P "${pid}" 2>/dev/null || true); do
    kill_pid_tree "${child}"
  done
  kill -TERM "${pid}" 2>/dev/null || true
}

wait_for_port_free() {
  local port="${1}" i=0
  while [[ "${i}" -lt 30 ]]; do
    if ! ss -ltn 2>/dev/null | grep -q ":${port} "; then
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done
  return 1
}

stop_previous_server() {
  local model_re pids pid still_running
  model_re="$(escape_regex "${MODEL_PATH}")"
  pids="$(find_previous_pids "${model_re}" "${PORT}")"

  if [[ -z "${pids// /}" ]]; then
    return 0
  fi

  echo "Stopping previous server on port ${PORT} (PIDs: ${pids})..."
  for pid in ${pids}; do
    kill_pid_tree "${pid}"
  done

  for _ in $(seq 1 30); do
    still_running="$(find_previous_pids "${model_re}" "${PORT}")"
    [[ -z "${still_running// /}" ]] && break
    sleep 1
  done

  still_running="$(find_previous_pids "${model_re}" "${PORT}")"
  if [[ -n "${still_running// /}" ]]; then
    echo "Force killing remaining processes: ${still_running}"
    for pid in ${still_running}; do
      kill -KILL "${pid}" 2>/dev/null || true
      pkill -KILL -P "${pid}" 2>/dev/null || true
    done
    sleep 1
  fi

  if ! wait_for_port_free "${PORT}"; then
    echo "WARNING: port ${PORT} still in use after stop attempt" >&2
  fi
}

health_host() {
  local host="${1}"
  [[ "${host}" == "0.0.0.0" || "${host}" == "::" ]] && host="127.0.0.1"
  printf '%s' "${host}"
}

health_url() {
  printf 'http://%s:%s/health' "$(health_host "${HOST}")" "${PORT}"
}

server_alive() {
  kill -0 "${1}" 2>/dev/null
}

wait_for_server_ready() {
  local pid="${1}" url="${2}" timeout="${3}" elapsed=0

  echo "Waiting for server to become ready (timeout ${timeout}s)..."
  while [[ "${elapsed}" -lt "${timeout}" ]]; do
    if ! server_alive "${pid}"; then
      echo "ERROR: server process ${pid} exited during startup." >&2
      echo "Last log lines:" >&2
      tail -30 "${LOG_FILE}" >&2
      exit 1
    fi

    if curl -sf "${url}" >/dev/null 2>&1; then
      return 0
    fi

    sleep 2
    elapsed=$((elapsed + 2))
    if (( elapsed % 30 == 0 )); then
      echo "  still starting... (${elapsed}s, tail -f ${LOG_FILE})"
    fi
  done

  echo "ERROR: server did not become ready within ${timeout}s." >&2
  tail -30 "${LOG_FILE}" >&2
  exit 1
}

validate_slots() {
  local slots="${1}"
  [[ "${slots}" =~ ^[0-9]+(,[0-9]+)*$ ]] || {
    echo "ERROR: invalid slot value: ${slots} (use e.g. 0 or 0,1)" >&2
    exit 1
  }
  printf '%s' "${slots}"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      -y|--yes)
        SKIP_INTERACTIVE=1
        shift
        ;;
      -slot=*)
        SLOT="${1#-slot=}"
        shift
        ;;
      -slot)
        [[ $# -ge 2 ]] || {
          echo "ERROR: -slot requires a value" >&2
          exit 1
        }
        SLOT="$2"
        shift 2
        ;;
      -port=*)
        PORT="${1#-port=}"
        shift
        ;;
      -port)
        [[ $# -ge 2 ]] || { echo "ERROR: -port requires a value" >&2; exit 1; }
        PORT="$2"
        shift 2
        ;;
      -tp=*)
        TP_SIZE="${1#-tp=}"
        shift
        ;;
      -tp)
        [[ $# -ge 2 ]] || { echo "ERROR: -tp requires a value" >&2; exit 1; }
        TP_SIZE="$2"
        shift 2
        ;;
      -dp=*)
        DP_SIZE="${1#-dp=}"
        shift
        ;;
      -dp)
        [[ $# -ge 2 ]] || { echo "ERROR: -dp requires a value" >&2; exit 1; }
        DP_SIZE="$2"
        shift 2
        ;;
      *)
        echo "ERROR: unknown argument: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

config_complete() {
  [[ -n "${SLOT}" && -n "${PORT}" && -n "${TP_SIZE}" && -n "${DP_SIZE}" ]]
}

resolve_config() {
  parse_args "$@"

  if [[ "${SKIP_INTERACTIVE}" == "1" ]]; then
    SLOT="${SLOT:-0}"
    PORT="${PORT:-8000}"
    TP_SIZE="${TP_SIZE:-1}"
    DP_SIZE="${DP_SIZE:-1}"
  elif [[ -t 0 ]] && ! config_complete; then
    SLOT="${SLOT:-0}"
    PORT="${PORT:-8000}"
    TP_SIZE="${TP_SIZE:-1}"
    DP_SIZE="${DP_SIZE:-1}"
    run_launch_wizard "${MODEL_NAME}" "${MODEL_PATH}"
    [[ "${WIZ_LAUNCH_ABORT:-0}" == "1" ]] && exit 0
  else
    SLOT="${SLOT:-${CUDA_VISIBLE_DEVICES:-0}}"
    PORT="${PORT:-8000}"
    TP_SIZE="${TP_SIZE:-1}"
    DP_SIZE="${DP_SIZE:-1}"
  fi

  SLOT="$(validate_slots "${SLOT}")"
  validate_port "${PORT}" || exit 1
  validate_positive_int "tp-size" "${TP_SIZE}" || exit 1
  validate_positive_int "dp-size" "${DP_SIZE}" || exit 1

  local trimmed
  trimmed="$(validate_parallel_plan "${SLOT}" "${TP_SIZE}" "${DP_SIZE}")" || exit 1
  SLOT="${trimmed}"
  CUDA_VISIBLE_DEVICES="${SLOT}"
}

resolve_config "$@"

if [[ ! -x "${PYTHON}" ]]; then
  echo "ERROR: ${PYTHON} not found. Run ./scripts/qwen3.8-27b-fp8/sglang-install first." >&2
  exit 1
fi

echo "Using GPU(s): ${CUDA_VISIBLE_DEVICES}  tp-size=${TP_SIZE}  dp-size=${DP_SIZE}  port=${PORT}"

if [[ "${SKIP_INTERACTIVE}" == "1" || "${WIZ_REPLACE:-0}" == "1" ]]; then
  stop_previous_server
fi

VENV_BIN="$(dirname "${PYTHON}")"
export PATH="${VENV_BIN}:${PATH}"
export SGLANG_CACHE_DIR
mkdir -p "${SGLANG_CACHE_DIR}"
: > "${LOG_FILE}"

LAUNCH_ARGS=(
  --model-path "${MODEL_PATH}"
  --tp-size "${TP_SIZE}"
  --host "${HOST}"
  --port "${PORT}"
  --trust-remote-code
  --reasoning-parser qwen3
  --tool-call-parser qwen3_coder
  --mem-fraction-static "${MEM_FRACTION_STATIC}"
  --mamba-ssm-dtype bfloat16
  --chunked-prefill-size 2048
  --attention-backend triton
)

if [[ "${DP_SIZE}" -gt 1 ]]; then
  LAUNCH_ARGS+=(--dp-size "${DP_SIZE}")
fi

nohup env CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES}" \
  SGLANG_CACHE_DIR="${SGLANG_CACHE_DIR}" \
  PATH="${PATH}" \
  "${PYTHON}" -m sglang.launch_server \
  "${LAUNCH_ARGS[@]}" \
  >> "${LOG_FILE}" 2>&1 &

SERVER_PID=$!
disown "${SERVER_PID}" 2>/dev/null || true
printf '%s\n' "${SERVER_PID}" > "${PID_FILE}"

HEALTH_HOST="$(health_host "${HOST}")"
wait_for_server_ready "${SERVER_PID}" "$(health_url)" "${STARTUP_TIMEOUT}"

echo "Server is ready (running in background)."
echo "  PID:    ${SERVER_PID}"
echo "  Log:    ${LOG_FILE}"
echo "  URL:    http://${HEALTH_HOST}:${PORT}"
echo "  Check:  curl http://${HEALTH_HOST}:${PORT}/health"
echo "  Follow: tail -f ${LOG_FILE}"
